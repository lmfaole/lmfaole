{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lmfaole/lmfaole/presentasjoner/presentasjon.schema.json",
  "title": "Presentasjon",
  "description": "Innholdet i en presentasjon (.pptx-filen er ikke versjonert). Lages med scripts/pptx_to_json.py og sjekkes med scripts/check.py.",
  "type": "object",
  "required": ["title", "file", "aspect", "slides"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "file": { "description": "Navnet på .pptx-filen (ikke i repoet).", "type": "string", "pattern": "\\.pptx$" },
    "aspect": { "type": "string", "enum": ["16:9", "4:3"] },
    "slides": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slide" } }
  },
  "$defs": {
    "paragraphs": {
      "description": "Avsnitt: en tekst, eller [tekst, nivå] når den er rykket inn.",
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "array",
            "prefixItems": [{ "type": "string", "minLength": 1 }, { "type": "integer", "minimum": 1 }],
            "minItems": 2,
            "maxItems": 2
          }
        ]
      }
    },
    "slide": {
      "type": "object",
      "required": ["n", "layout", "title"],
      "additionalProperties": false,
      "properties": {
        "n": { "description": "Slidenummer, fra 1 og uten hull.", "type": "integer", "minimum": 1 },
        "layout": { "description": "Navnet på layouten i malen.", "type": "string", "minLength": 1 },
        "hidden": { "description": "Skjult (reserveslide).", "type": "boolean" },
        "title": { "type": ["string", "null"] },
        "time": { "description": "Tidsstempelet fra starten av notatene, f.eks. 0:40–1:10.", "type": "string", "pattern": "^\\d+:\\d\\d(–\\d+:\\d\\d)?$" },
        "text": {
          "description": "Tekst i plassholderne, etter plassholderens idx i layouten (tittelen, idx 0, står i title).",
          "type": "object",
          "propertyNames": { "pattern": "^[1-9]\\d*$" },
          "additionalProperties": { "$ref": "#/$defs/paragraphs" }
        },
        "textboxes": { "description": "Tekstbokser utenfor plassholderne.", "type": "array", "items": { "$ref": "#/$defs/paragraphs" } },
        "pictures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "alt"],
            "additionalProperties": false,
            "properties": {
              "file": { "description": "Bildet i mappens bilder/.", "type": "string", "pattern": "^bilder/[^/]+$" },
              "placeholder": { "type": "integer", "minimum": 0 },
              "alt": { "type": "string" },
              "decorative": { "type": "boolean" }
            }
          }
        },
        "media": {
          "description": "Video og lyd. Filene er ikke versjonert.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name", "alt"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["video", "audio"] },
              "name": { "type": "string", "minLength": 1 },
              "file": { "description": "Filnavnet inni .pptx-filen.", "type": ["string", "null"] },
              "alt": { "type": "string" },
              "decorative": { "type": "boolean" }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "url"],
            "additionalProperties": false,
            "properties": { "text": { "type": "string" }, "url": { "type": "string", "minLength": 1 } }
          }
        },
        "notes": { "description": "Foredragsnotatene.", "type": "string" }
      }
    }
  }
}
