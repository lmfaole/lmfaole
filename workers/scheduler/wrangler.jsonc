{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scheduler",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Only the cron: no address at all.
  "workers_dev": false,
  "preview_urls": false,
  // The Workers whose `scheduled` it calls (src/jobs.ts). Each call is a new invocation of that Worker, with its own 50 subrequests and CPU time.
  "services": [
    { "binding": "ACTIVITY", "service": "activity" },
    { "binding": "LIKES_SYNC", "service": "likes-sync" },
    { "binding": "STARTSIDE", "service": "startside" }
  ],
  // The account's only cron (the free plan has five). Every job's own schedule is in src/jobs.ts and must fall on these quarter hours.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
