{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catalog",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Only `scheduled`: no address at all.
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "GITHUB_USER": "lmfaole", "GITHUB_FIRST_YEAR": "2018" },
  // The schemas are in packages/db. The ids are the same as in packages/db/wrangler.jsonc: fill in both with what
  // `npx wrangler d1 create site` and `npx wrangler d1 create library` print.
  "d1_databases": [
    { "binding": "SITE", "database_name": "site", "database_id": "site-not-created-yet", "migrations_dir": "../../packages/db/site/migrations" },
    { "binding": "LIBRARY", "database_name": "library", "database_id": "library-not-created-yet", "migrations_dir": "../../packages/db/library/migrations" }
  ],
  // No cron of its own: workers/scheduler calls `scheduled` every six hours (15 */6 * * *); the 06:15 UTC run does Hardcover too.
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
  // Secrets: GITHUB_TOKEN (a fine-grained token with public repositories read-only and no permissions), HARDCOVER_TOKEN (monorepo/secrets/books-sync.env).
}
