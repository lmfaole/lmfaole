{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "activity",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "LISTENBRAINZ_USER": "lmfaole", "LASTFM_USER": "snowpony69", "TRAKT_USER": "lmfaole", "LETTERBOXD_USER": "lmfaole" },
  "d1_databases": [
    { "binding": "MUSIC", "database_name": "music", "database_id": "ca72bd29-9022-4bfc-b4cc-d7968d91fa1b", "migrations_dir": "migrations/music" },
    { "binding": "GAMES", "database_name": "gameplay", "database_id": "5d315e5c-61b7-465a-a7e0-d3e3ab6d44bc", "migrations_dir": "migrations/gameplay" },
    { "binding": "WATCHING", "database_name": "watching", "database_id": "de856333-5317-41e0-99be-0b01e43101ec", "migrations_dir": "migrations/watching" }
  ],
  // No cron of its own: workers/scheduler calls `scheduled` every three hours (0 */3 * * *). The weekly backup is .github/workflows/d1-backup.yml.
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
  // Secrets: STEAM_API_KEY, STEAM_ID, RA_USER, RA_API_KEY (monorepo/secrets/games-sync.env), LASTFM_API_KEY (music-sync.env), TRAKT_CLIENT_ID (tv-sync.env).
}
