---
// The 404 of an app: an address under its base that no page owns, back to the app's front page. `src/pages/404.astro` draws it.
import { NotFoundPage } from '@lmfaole/designsystem/components/not-found-page'

import Document from './Document.astro'

interface Props {
  /** The app's name, after the title («Siden finnes ikke – CV»). */
  app: string
  /** As `Document`'s. */
  appleTouchIcon?: boolean
}
const { app, appleTouchIcon = false } = Astro.props
---

<Document title={`Siden finnes ikke – ${app}`} appleTouchIcon={appleTouchIcon}>
  <NotFoundPage home={import.meta.env.BASE_URL} />
</Document>
