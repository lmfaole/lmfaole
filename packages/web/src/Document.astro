---
// The document every page of an app stands in: the head (title, description, link preview, icons) and the page frame. No service worker, no cookies
// and no script of its own: the origin lmfaole.party is shared by every app, each under its own path. An app with more (medier: its brand, manifest
// and menu) gives it through `attributes` and the slots `head` (the end of `<head>`) and `nav` (`PageLayout`'s menu); without them the document is the same.
import './styles.css'
import { PageLayout } from '@lmfaole/designsystem/components/page-layout'

interface Props {
  title: string
  description?: string | undefined
  /** The page's own address, for the link preview; none for a page that is not one (the 404). */
  url?: string | undefined
  /** `pane`: the reading column and the facts beside it on a wide screen. */
  width?: 'reading' | 'pane'
  /** The link preview's picture: a file in `public/` (under the base) and its size; none, no picture. */
  image?: { file: string; width: number; height: number } | undefined
  /** The app has `public/apple-touch-icon.png` too, the icon a phone puts on its home screen. */
  appleTouchIcon?: boolean
  /** Structured data about the page (schema.org). */
  jsonLd?: Record<string, unknown> | undefined
  /** The app has `public/favicon.ico`; `false` for one whose icons are in the slot `head`. */
  favicon?: boolean
  /** More attributes of `<html>` (the design system's `brandAttributes`, `transitionAttributes`). */
  attributes?: Record<string, string> | undefined
}
const { title, description, url, width = 'reading', image, appleTouchIcon = false, jsonLd, favicon = true, attributes = {} } = Astro.props
const base = import.meta.env.BASE_URL
const imageUrl = image === undefined ? undefined : new URL(`${base}${image.file}`, Astro.site).href
const json = jsonLd === undefined ? null : JSON.stringify(jsonLd).replaceAll('<', '\\u003c')
---

<!doctype html>
<html lang="nb" {...attributes}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description === undefined ? null : <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    {favicon ? <link rel="icon" href={`${base}favicon.ico`} sizes="any" /> : null}
    {appleTouchIcon ? <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} /> : null}
    {
      url === undefined ? null : (
        <>
          <link rel="canonical" href={url} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="lmfaole.party" />
          <meta property="og:locale" content="nb_NO" />
          <meta property="og:url" content={url} />
          <meta property="og:title" content={title} />
          {description === undefined ? null : <meta property="og:description" content={description} />}
          {
            image === undefined ? null : (
              <>
                <meta property="og:image" content={imageUrl} />
                <meta property="og:image:width" content={String(image.width)} />
                <meta property="og:image:height" content={String(image.height)} />
              </>
            )
          }
        </>
      )
    }
    {json === null ? null : <script type="application/ld+json" set:html={json} />}
    <slot name="head" />
  </head>
  <body>
    {
      Astro.slots.has('nav') ? (
        <PageLayout width={width}>
          <slot name="nav" slot="nav" />
          <slot />
        </PageLayout>
      ) : (
        <PageLayout width={width}>
          <slot />
        </PageLayout>
      )
    }
  </body>
</html>
