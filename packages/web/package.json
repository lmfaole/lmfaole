{
  "name": "@lmfaole/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "What every Astro app on lmfaole.party shares: the Astro config, the security headers, the edge's page cache, D1 reading, the document and the 404, the tsconfig. Shipped as source.",
  "repository": "github:lmfaole/lmfaole",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./config": "./src/config.ts",
    "./headers": "./src/headers.ts",
    "./middleware": "./src/middleware.ts",
    "./page-cache": "./src/page-cache.ts",
    "./d1": "./src/d1.ts",
    "./conventions": "./src/conventions.ts",
    "./testing": "./src/testing.ts",
    "./Document.astro": "./src/Document.astro",
    "./NotFound.astro": "./src/NotFound.astro",
    "./styles.css": "./src/styles.css",
    "./env": {
      "types": "./src/env.d.ts"
    },
    "./tsconfig.app.json": "./tsconfig.app.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/react": "^7.1.2",
    "@lmfaole/designsystem": "*",
    "@lmfaole/worker": "*",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "~7.0.2"
  }
}
