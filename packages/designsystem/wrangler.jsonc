{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "designsystem",
  "compatibility_date": "2026-11-01",
  // Only the files of Storybook (`npm run build-storybook`, into storybook-static/design/ so a path /design/… is a file): no script, so a request is a file or a 404.
  "assets": { "directory": "./storybook-static" },
  // Only the route lmfaole.party/design: no workers.dev or preview address, so the design system's Storybook has one address.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "lmfaole.party/design*", "zone_name": "lmfaole.party" }]
}
