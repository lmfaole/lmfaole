{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "startside",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Only the route: one address, behind the page cache and the rate limit in worker.mjs.
  "workers_dev": false,
  "preview_urls": false,
  // Workers AI, for the summaries: only the cron job calls it (lib/summaries.ts, at most two a run); the pages read them from KV.
  "ai": { "binding": "AI" },
  // The relay (upstream/), called inside Cloudflare instead of over its workers.dev address (lib/relay.ts). Deployed first (deploy.yml).
  "services": [{ "binding": "UPSTREAM", "service": "startside-upstream" }],
  // The snapshot and the summaries the cron fills (lib/snapshot.ts, lib/summaries.ts). No id: wrangler deploy creates the namespace the first time (automatic provisioning).
  "kv_namespaces": [{ "binding": "SNAPSHOT" }],
  // No cron of its own: workers/scheduler calls `scheduled` (worker.mjs) every 15 minutes to put the shared sources into the snapshot. 96 runs a day, at most five KV writes each (three snapshot bodies, the index, the summaries).
  "triggers": { "crons": [] },
  // Per visitor (CF-Connecting-IP) and colo, for everything but the static files (worker.mjs): the page is open, and a page that is not
  // in the cache calls the relay. The namespace id is the account's own number for this limit, unique among the account's Workers.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1201", "simple": { "limit": 120, "period": 60 } }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "lmfaole.party/start*", "zone_name": "lmfaole.party" }],
  "vars": {
    // GitHub: whose public data the page shows (the only user; there are no settings).
    "GITHUB_USER": "lmfaole",
    // GitHub: the repositories whose issues are watched (the ones you are involved in, new ones nobody owns, what moved lately).
    "GITHUB_WATCH_REPOS": "fremtind/jokul",
    // The place for the weather and the front page when the address has no position (?pos=): also the price area's default (NO1).
    "WEATHER_PLACE": "Oslo",
    "WEATHER_LAT": "59.91",
    "WEATHER_LON": "10.75",
    // AI Gateway for the summaries (lib/ai-gateway.ts, called by the cron only): «default» is created by Cloudflare on the first call; empty for none.
    "AI_GATEWAY": "default",
    // "1" once Image Transformations is on for lmfaole.party with github.com and avatars.githubusercontent.com allowed: avatars as AVIF/WebP via /cdn-cgi/image.
    "IMAGE_TRANSFORMS": "0",
    // Web Analytics' site token (32 hex); empty, no beacon.
    "CF_BEACON_TOKEN": ""
  }
}
