# Copy to .dev.vars for local development. In production the token is a secret on the relay (`startside-upstream`).
# A fine-grained token with «Public repositories (read-only)» and no other access: the page is open to anyone, so it must not be able to read anything private.
GITHUB_TOKEN=

# No keys and no network: every upstream answers from fixtures (lib/mock.ts). Never set this in production.
# MOCK_DATA=1
# GITHUB_WATCH_REPOS=fremtind/jokul,navikt/aksel
# HOME_LAT=59.9226
# HOME_LON=10.7586
