# Copy to .dev.vars for local development. In production: `wrangler secret put GITHUB_TOKEN`.
# A fine-grained or classic token that can read your pull requests and issues.
GITHUB_TOKEN=

# No keys and no network: every upstream answers from fixtures (lib/mock.ts). Never set this in production.
# MOCK_DATA=1
# GITHUB_WATCH_REPOS=fremtind/jokul,navikt/aksel
# HOME_LAT=59.9226
# HOME_LON=10.7586

# `npm run preview` (wrangler dev) has no Cloudflare Access in front, so the Worker's check of its token is skipped.
# Never set this in wrangler.jsonc or as a secret in production.
# ACCESS_SKIP=1
