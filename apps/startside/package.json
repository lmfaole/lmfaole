{
  "name": "startside",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/*.test.ts upstream/*.test.js",
    "preview": "npm run build:worker && wrangler dev",
    "deploy": "npm run build:worker && wrangler deploy",
    "build:worker": "opennextjs-cloudflare build && node scripts/embed-assets.mjs",
    "skills": "designsystem-skills",
    "skills:check": "designsystem-skills --check",
    "icons": "designsystem-app-icons --hue teal --glyph sunrise --apple app/apple-icon.png --favicon app/icon.png --svg app/icon.svg"
  },
  "dependencies": {
    "@lmfaole/designsystem": "*",
    "@opennextjs/cloudflare": "^1.20.17",
    "next": "^16.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
  }
}
