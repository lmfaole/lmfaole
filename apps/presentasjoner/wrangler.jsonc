{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "presentasjoner",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Only the zone's routes: no workers.dev or preview address, and no custom domain, so the site has one address.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Paths of lmfaole.party: `forside` owns `lmfaole.party/*`, and these two are more specific, so they reach this Worker.
  "routes": [
    { "pattern": "lmfaole.party/presentasjoner", "zone_name": "lmfaole.party" },
    { "pattern": "lmfaole.party/presentasjoner/*", "zone_name": "lmfaole.party" }
  ],
  // The talks to download, `<slug>/<the .pptx's name>.pdf` and `.pptx` (`README.md` says how they get there). The site only reads them (`src/lib/download.ts`).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "presentasjoner" }]
}
