{
  "name": "presentasjoner",
  "private": true,
  "type": "module",
  "description": "Presentasjonene mine på lmfaole.party/presentasjoner/: innholdet slide for slide, og hver som PDF",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/downloads.mjs && astro dev",
    "build": "node scripts/downloads.mjs && astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test && python3 scripts/check.py",
    "typecheck": "tsc --noEmit",
    "skills": "designsystem-skills",
    "skills:check": "designsystem-skills --check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/react": "^7.1.2",
    "@lmfaole/designsystem": "*",
    "@lmfaole/web": "*",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.164.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "~7.0.2"
  }
}
