---
// The page a detail page is in place of its own when the visitor has not given the username its service needs: the list it belongs to, and the form asking for it.
import Page from '../layouts/Page.astro'
import { MEDIA, mediumHref } from '../lib/media'
import type { Medium } from '../lib/week-source'
import UsernameGate from './UsernameGate.astro'

interface Props {
  medium: Medium
}

const { medium } = Astro.props
const base = import.meta.env.BASE_URL
const info = MEDIA[medium]
---

<Page current={info.place} title={info.label} lead={`Siden viser data fra ${info.service === 'lastfm' ? 'Last.fm' : 'Trakt'} for brukernavnet du oppgir.`} crumbs={[{ label: 'Medier', href: base }, { label: info.label, href: mediumHref(base, medium) }]}>
  <UsernameGate services={[info.service]} />
</Page>
