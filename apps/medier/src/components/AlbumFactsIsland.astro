---
// A server island: the label and the country of the album's first release are MusicBrainz's, asked a second apart and kept for a month; the fact is empty until it answers.
import { albumRelease, owner } from '../lib/runtime'
import { AlbumLabel } from './detail'

interface Props {
  artist: string
  title: string
}

const { artist, title } = Astro.props
const release = await albumRelease(owner(), artist, title, false)
---

<AlbumLabel release={release?.first ?? null} />
