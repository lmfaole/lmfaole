---
// A server island: who made the album, its other editions and its place among the artist's albums are MusicBrainz's, up to three asks a second apart (each kept for a month), with the owner's
// plays of each of the artist's albums (their thousand most played of all time, one answer every album's page shares).
import { discographyChartText } from '../lib/album-listening'
import { albumRelease, owner } from '../lib/runtime'
import { AlbumRelease } from './detail'
import { DiscographyChart } from './trend'

interface Props {
  artist: string
  title: string
  base: string
  /** The artist's albums that have a page here: by `albumKey`, the title each was played under. */
  linked: [string, string][]
}

const { artist, title, base, linked } = Astro.props
const release = await albumRelease(owner(), artist, title, true)
const discography = release?.discography ?? null
const chart = discography === null ? null : discographyChartText(discography, title, artist)
---

{release !== null && (discography === null || chart === null) && <AlbumRelease release={release} artist={artist} base={base} linked={new Map(linked)} />}
{release !== null && discography !== null && chart !== null && (
  <AlbumRelease release={release} artist={artist} base={base} linked={new Map(linked)}>
    <DiscographyChart
      slot="chart"
      client:visible
      title={chart.title}
      description={chart.description}
      summary={chart.summary}
      highlight={chart.highlight}
      ariaLabel={`Avspillinger av hvert studioalbum av ${artist}`}
      albums={discography}
    />
  </AlbumRelease>
)}
