---
// The first visit's wizard, drawn open by the server (no flash) when the `seen` cookie lacks it, and made a modal of steps by `FirstRunEnhancer`; without JavaScript it is one long form.
import { EffectsChoice, TiltChoice } from '@lmfaole/designsystem/components/appearance-settings'
import { FirstRunEnhancer } from '@lmfaole/designsystem/components/first-run-enhancer'
import { InstallPrompt } from '@lmfaole/designsystem/components/install-prompt'
import { parsePrefs, PREFS_COOKIE } from '@lmfaole/designsystem/lib/preferences'
import { SEEN_PATH } from '../lib/onboarding'
import { usersOf } from '../lib/runtime'
import { isStep, STEP_PARAM } from '../lib/settings-form'
import { backWithoutError, formError, usernameFields } from '../lib/users'
import { firstRunOpen } from '../lib/visitor-cookies'
import { MedierFirstRun } from './settings-fields'

const open = firstRunOpen(Astro.cookies, Astro.url)
const base = import.meta.env.BASE_URL
const step = Astro.url.searchParams.get(STEP_PARAM)
const users = usersOf(Astro.cookies)
const [lastfm, trakt] = usernameFields(['lastfm', 'trakt'], users, formError(Astro.url.searchParams))
const prefs = parsePrefs(Astro.cookies.get(PREFS_COOKIE)?.value)
const here = new URL(Astro.url)
here.searchParams.delete(STEP_PARAM)
const back = backWithoutError(`${here.pathname}${here.search}`)
---

{
  open && lastfm !== undefined && trakt !== undefined && (
    <>
      <MedierFirstRun open action={`${base}api/innstillinger/`} validateUrl={`${base}api/innstillinger/`} back={back} initialStep={isStep(step) ? step : undefined} lastfm={lastfm} trakt={trakt} prefs={prefs}>
        <EffectsChoice slot="effectsField" client:load value={prefs.effects} />
        <TiltChoice slot="tiltField" client:load value={prefs.tilt} />
        <InstallPrompt slot="install" client:idle appName="Medier" seen={false} cookiePath={SEEN_PATH} />
      </MedierFirstRun>
      <FirstRunEnhancer client:load />
    </>
  )
}
