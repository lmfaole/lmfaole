---
// A server island: an artist's concerts are a question to setlist.fm (kept for a day), with a budget of its own; a cold artist's page has used most of the Worker's limit.
import { setlists } from '../lib/runtime'
import { Setlists } from './detail'

interface Props {
  /** MusicBrainz's id of the artist, from Last.fm; setlist.fm finds an artist by it, and without it there is nothing to ask (a name could be another artist's). */
  mbid: string | null
}

const { mbid } = Astro.props
const found = await setlists(mbid)
---

<Setlists setlists={found} />
