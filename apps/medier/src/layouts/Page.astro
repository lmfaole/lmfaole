---
import Document from '@lmfaole/web/Document.astro'
import { Breadcrumbs, type Crumb } from '@lmfaole/designsystem/components/breadcrumbs'
import { PageHeader } from '@lmfaole/designsystem/components/page-header'
import { ConnectionBanner } from '@lmfaole/designsystem/components/connection-banner'

import { navItems, type Place } from '../components/frame'
import { NavBar } from '@lmfaole/designsystem/components/nav-bar'
import { brandAttributes } from '@lmfaole/designsystem/lib/brand'
import { transitionAttributes } from '@lmfaole/designsystem/lib/motion'
import { WebAnalytics } from '@lmfaole/designsystem/components/web-analytics'
import { beaconToken, hasRetro, hasSteam, owner } from '../lib/runtime'
import { hasMusic } from '../lib/users'

interface Props {
  title: string
  lead: string
  /** The pages above this one, and this one last; none on a page in the menu (the front page, Musikk, Film, TV, Spill): the menu says where it is. */
  crumbs?: Crumb[]
  /** `pane` for a detail page: the reading column and the `DetailLayout` rail beside it on a wide screen. */
  width?: 'reading' | 'pane'
  /** The place of the app this page is in (for a detail page, the list it belongs to); none for a page that is in none (the offline page). */
  current?: Place
  /** A page whose own head (`DetailHeader`) is its `<h1>`: the title and the lead are in the document's head and its description, and not drawn here. */
  bare?: boolean
}
const { title, lead, crumbs, width = 'reading', current, bare = false } = Astro.props
const base = import.meta.env.BASE_URL
// A place is in the bar where it has a username (and «Spill» a key to Steam or RetroAchievements). A page made ahead of time (the offline page) reads no settings: it has Musikk, Film and TV.
const users = Astro.isPrerendered ? null : owner()
const shown = users === null
  ? { music: true, film: true, tv: true, games: false }
  : { music: hasMusic(users), film: users.trakt !== null, tv: users.trakt !== null, games: (hasSteam() && users.steam !== null) || (hasRetro() && users.retroachievements !== null) }
// Cloudflare Web Analytics (`CF_BEACON_TOKEN`, public): drawn here, on the server, with no island (it is a plain script tag); nothing without a token, or on a page made ahead of time.
const beacon = Astro.isPrerendered ? '' : beaconToken()
// The document and its frame are the apps' shared one (`@lmfaole/web`), with medier's own: the brand, the installed app's head and the menu. With the brand's hue, a change of page is the browser's own view transition (`transitionAttributes()`): the menu's current place slides to the new one and `<main>` rises in (design system, «Motion» §9; no `ClientRouter`).
---

<Document title={current === 'front' ? title : `${title} – Medier`} description={lead} width={width} favicon={false} attributes={{ ...brandAttributes('amber'), ...transitionAttributes() }}>
  <Fragment slot="head">
    <!-- The installed app: the manifest, the colour of the bar in each scheme (the brand's amber, light and dark: `npx designsystem-app-icons`), the icons, and Safari's own way of saying «installed». -->
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#9c640d" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#c6811c" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Medier" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  </Fragment>
  <NavBar slot="nav" client:load title="Medier" glyph="play" items={navItems(base, current, shown)} />
  <ConnectionBanner client:idle />
  {crumbs === undefined ? null : <Breadcrumbs items={crumbs} />}
  {bare ? null : <PageHeader title={title} description={lead} />}
  <slot />
  <script>
    // The controls marked `data-haptic` give a short buzz where the phone can (design system, «Haptics»).
    import { listenForHaptics } from '@lmfaole/designsystem/lib/haptics'
    import { listenForPendingForms } from '@lmfaole/designsystem/lib/pending-forms'
    listenForHaptics()
    listenForPendingForms()
  </script>
  <WebAnalytics token={beacon} />
  <script is:inline define:vars={{ base }}>
    // The service worker makes the app open without a network (`public/sw.js`); a browser without one, or one that refuses it, simply has the site as before. Its scope is the site's base
    // (`/medier/`), never the origin's root, which is the other apps'.
    if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch(() => {}))
  </script>
</Document>
