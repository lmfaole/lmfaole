---
// The usernames: whose data the site shows. Only shown here and on the overview, not on every page.
import SettingsPage from '../../components/SettingsPage.astro'
import { SettingsForm, UsernameInput } from '../../components/settings-fields'
import { hasRetro, hasSteam, usersOf } from '../../lib/runtime'
import { settingsPageBack } from '../../lib/settings-form'
import { formError, safeBack, usernameFields } from '../../lib/users'

const base = import.meta.env.BASE_URL
const tilbake = Astro.url.searchParams.get('tilbake')
// Steam and RetroAchievements only where the site has their keys: without it a profile would show nothing.
const [lastfm, trakt, listenbrainz, ...games] = usernameFields(['lastfm', 'trakt', 'listenbrainz', ...(hasSteam() ? (['steam'] as const) : []), ...(hasRetro() ? (['retroachievements'] as const) : [])], usersOf(Astro.cookies), formError(Astro.url.searchParams))
const back = settingsPageBack(base, 'kontoer', tilbake === null ? null : safeBack(tilbake, base))
---

<SettingsPage page="kontoer">
  {
    lastfm !== undefined && trakt !== undefined && listenbrainz !== undefined && (
      <SettingsForm action={`${base}api/innstillinger/`} back={back}>
        <p>La et felt stå tomt for å glemme brukernavnet.</p>
        <UsernameInput field={lastfm} />
        <UsernameInput field={trakt} />
        <UsernameInput field={listenbrainz} />
        {games.map((field) => <UsernameInput field={field} />)}
      </SettingsForm>
    )
  }
</SettingsPage>
