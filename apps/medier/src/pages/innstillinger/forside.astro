---
// The front page: which sections it has (checkboxes) and their order (`ReorderList`: drag, or «Flytt opp» / «Flytt ned», which post the form without JavaScript).
import { ReorderList } from '@lmfaole/designsystem/components/reorder-list'
import { orderSections, parsePrefs, PREFS_COOKIE } from '@lmfaole/designsystem/lib/preferences'
import SettingsPage from '../../components/SettingsPage.astro'
import { SectionsField, SettingsForm } from '../../components/settings-fields'
import { FRONT_SECTION_IDS, FRONT_SECTIONS, settingsPageBack } from '../../lib/settings-form'
import { safeBack } from '../../lib/users'

const base = import.meta.env.BASE_URL
const tilbake = Astro.url.searchParams.get('tilbake')
const prefs = parsePrefs(Astro.cookies.get(PREFS_COOKIE)?.value)
const back = settingsPageBack(base, 'forside', tilbake === null ? null : safeBack(tilbake, base))
const items = orderSections(FRONT_SECTION_IDS, prefs.order).flatMap((id) => FRONT_SECTIONS.filter((section) => section.value === id).map(({ value, label, description, icon }) => ({ id: value, label, description, icon })))
---

<SettingsPage page="forside">
  <SettingsForm action={`${base}api/innstillinger/`} back={back}>
    <SectionsField prefs={prefs} />
    <ReorderList client:load name="order" legend="Rekkefølge" hint="Dra i håndtaket, eller bruk knappene. Seksjoner du har valgt bort, beholder plassen sin til du tar dem med igjen." items={items} />
  </SettingsForm>
</SettingsPage>
