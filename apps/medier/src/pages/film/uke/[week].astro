---
import Wrapped from '../../../components/Wrapped.astro'
import { owner, week as loadWeek } from '../../../lib/runtime'
import { parseWeek } from '../../../lib/weeks'

const week = parseWeek(Astro.params.week ?? '')
// A week that has not begun has nothing to tell, and an address that is no week is no page.
if (week === null || week.start * 1000 > Date.now()) return Astro.rewrite('/404/')
const users = owner()
const data = users.trakt === null ? null : await loadWeek(users, week, 'film')
if (data === null) return Astro.rewrite('/404/')
---

<Wrapped medium="film" period={{ kind: 'week', week }} data={data} />
