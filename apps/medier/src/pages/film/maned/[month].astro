---
import Wrapped from '../../../components/Wrapped.astro'
import { parseMonth } from '../../../lib/months'
import { month as loadMonth, owner } from '../../../lib/runtime'

const month = parseMonth(Astro.params.month ?? '')
// A month that has not begun has nothing to tell, and an address that is no month is no page.
if (month === null || month.start * 1000 > Date.now()) return Astro.rewrite('/404/')
const users = owner()
const data = users.trakt === null ? null : await loadMonth(users, month, 'film')
if (data === null) return Astro.rewrite('/404/')
---

<Wrapped medium="film" period={{ kind: 'month', month }} data={data} />
