---
import { PageSection } from '@lmfaole/designsystem/components/page-section'

import { HistoryTimeline, Sessions } from '../../../components/history'
import { Fetched } from '../../../components/sections'
import Page from '../../../layouts/Page.astro'
import { mediumHref } from '../../../lib/media'
import { owner, watched } from '../../../lib/runtime'

const base = import.meta.env.BASE_URL
const users = owner()
if (users.trakt === null) return Astro.rewrite('/404/')
const seen = await watched(users)
const items = (seen?.items ?? []).filter((watch) => watch.kind === 'film')
const now = new Date().toISOString()
---

<Page current="film" title="Historikk" lead="Sette filmer, dag for dag, og hvor lenge hver titteøkt varte, fra Trakt." crumbs={[{ label: 'Medier', href: base }, { label: 'Film', href: mediumHref(base, 'film') }, { label: 'Historikk', href: mediumHref(base, 'film', 'historikk/') }]}>
  <PageSection id="okter" title="Titteøkter" icon="film">
    <Sessions medium="film" watches={items} now={now} />
  </PageSection>
  <PageSection id="tidslinje" title="Tidslinje" icon="history">
    <HistoryTimeline medium="film" watches={items} now={now} base={base} />
  </PageSection>
  <Fetched sources={[{ at: seen?.at ?? null, source: 'Trakt' }]} />
</Page>
