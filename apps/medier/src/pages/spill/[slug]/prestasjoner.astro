---
import { EmptyState } from '@lmfaole/designsystem/components/empty-state'
import { PageSection } from '@lmfaole/designsystem/components/page-section'
import { Stack } from '@lmfaole/designsystem/components/layout'
import { Progress } from '@lmfaole/designsystem/components/progress'

import { AchievementRows } from '../../../components/games'
import Page from '../../../layouts/Page.astro'
import { lockedOf, unlockedOf } from '../../../lib/achievement-view'
import { gameHref, gameId } from '../../../lib/pages'
import { game, hasSteam, owner } from '../../../lib/runtime'

// Every achievement in a Steam game: the unlocked, the last first, and the ones still to get, the most common (the nearest) first. The game's page shows the last five and continues here.
const id = gameId(Astro.params.slug ?? '')
if (id === null || !hasSteam()) return Astro.rewrite('/404/')
const users = owner()
const detail = users.steam === null ? null : await game(users, id)
if (detail === null) return Astro.rewrite('/404/')
const base = import.meta.env.BASE_URL
if (Astro.params.slug !== gameHref('', id, detail.game.name).slice('spill/'.length, -1)) return Astro.redirect(`${gameHref(base, id, detail.game.name)}prestasjoner/`)
const achievements = detail.achievements == null || detail.achievements.total === 0 ? null : detail.achievements
const unlocked = achievements === null ? [] : unlockedOf(achievements.list)
const locked = achievements === null ? [] : lockedOf(achievements.list)
const name = detail.game.name
const crumbs = [{ label: 'Medier', href: base }, { label: 'Spill', href: `${base}spill/` }, { label: name, href: gameHref(base, id, name) }, { label: 'Prestasjoner', href: `${gameHref(base, id, name)}prestasjoner/` }]
---

<Page current="games" title="Prestasjoner" lead={`Alle prestasjonene i ${name}: de som er låst opp, sist først, og de som gjenstår, de vanligste først.`} crumbs={crumbs}>
  {
    achievements === null ? (
      <EmptyState reason="nothing-yet" what="prestasjoner" description="Spillet har ingen prestasjoner, eller de er ikke offentlige på profilen." />
    ) : (
      <>
        <PageSection id="laast-opp" title="Låst opp" icon="award">
          <Stack>
            <Progress label="Av alle prestasjonene" value={achievements.unlocked} max={achievements.total} valueText={`${achievements.unlocked} av ${achievements.total}`} />
            {unlocked.length === 0 ? <EmptyState reason="nothing-yet" what="prestasjoner" description="Ingen prestasjoner i spillet er låst opp ennå." /> : <AchievementRows list={unlocked} />}
          </Stack>
        </PageSection>
        {locked.length === 0 ? null : (
          <PageSection id="gjenstar" title="Gjenstår" icon="target">
            <AchievementRows list={locked} />
          </PageSection>
        )}
      </>
    )
  }
</Page>
