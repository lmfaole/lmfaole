---
import { ErrorMessage } from '@lmfaole/designsystem/components/error-message'
import { PageSection } from '@lmfaole/designsystem/components/page-section'

import { WishlistRows } from '../../../components/steam'
import Page from '../../../layouts/Page.astro'
import { hasSteam, owner, wishlist } from '../../../lib/runtime'

const users = owner()
if (!hasSteam() || users.steam === null) return Astro.rewrite('/404/')
const base = import.meta.env.BASE_URL
const list = await wishlist(users)
---

<Page current="games" title="Ønskeliste" lead="Ønskelisten på Steam, og hva som er på tilbud." crumbs={[{ label: 'Medier', href: base }, { label: 'Spill', href: `${base}spill/` }, { label: 'Ønskeliste', href: `${base}spill/onskeliste/` }]}>
  {
    list === null ? (
      <ErrorMessage what="ønskelisten" error="Steam svarte ikke, eller ønskelisten er ikke offentlig." />
    ) : (
      <>
        <PageSection id="tilbud" title="På tilbud" icon="sale" source={{ label: 'Steam' }}>
          <WishlistRows games={list.onSale} />
        </PageSection>
        <PageSection id="onskeliste" title="Hele ønskelisten" icon="favorite" source={{ label: 'Steam' }}>
          <WishlistRows games={list.games} />
        </PageSection>
      </>
    )
  }
</Page>
