---
import { TitleDetail } from '../../components/detail'
import { Head } from '../../components/head'
import { sourcesOf } from '../../lib/image-sources'
import NeedsUsername from '../../components/NeedsUsername.astro'
import Page from '../../layouts/Page.astro'
import WatchProvidersIsland from '../../components/WatchProvidersIsland.astro'
import { mediumHref } from '../../lib/media'
import { titleHref, titlePages } from '../../lib/pages'
import { usersOf, watched } from '../../lib/runtime'

const users = usersOf(Astro.cookies)
const seen = users.trakt === null ? null : await watched(users)
const pages = seen === null ? [] : titlePages(seen.items)
const page = pages.find((one) => one.kind === 'episode' && one.slug === Astro.params.slug)
// A show's address that is a film (an old address guessed wrong without the history): its own page.
const other = pages.find((one) => one.kind === 'film' && one.slug === Astro.params.slug)
if (page === undefined && other !== undefined) return Astro.redirect(titleHref(import.meta.env.BASE_URL, other.slug, other.kind))
if (users.trakt !== null && page === undefined) return Astro.rewrite('/404/')
const base = import.meta.env.BASE_URL
const kind = 'Serie'
---

{page === undefined ? (
  <NeedsUsername medium="tv" />
) : (
<Page bare current="tv"
  width="pane"
  title={page.title}
  lead={page.year === null ? kind : `${kind} · ${page.year}`}
  crumbs={[{ label: 'Medier', href: base }, { label: 'TV', href: mediumHref(base, 'tv') }, { label: page.title, href: titleHref(base, page.slug, page.kind) }]}
>
  <Head client:idle kind={page.year === null ? kind : `${kind} · ${page.year}`} title={page.title} sources={sourcesOf(page.poster)} shape="show" />
  <TitleDetail page={page} base={base}>
    <WatchProvidersIsland slot="providers" server:defer kind={page.kind} tmdbId={page.viewings.find((watch) => watch.tmdbId !== null)?.tmdbId ?? null} />
  </TitleDetail>
</Page>
)}
