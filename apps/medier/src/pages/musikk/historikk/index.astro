---
import { PageSection } from '@lmfaole/designsystem/components/page-section'

import { HistoryTimeline, Sessions } from '../../../components/history'
import { Fetched } from '../../../components/sections'
import Page from '../../../layouts/Page.astro'
import { mediumHref } from '../../../lib/media'
import { playingNow } from '../../../lib/now'
import { music, owner } from '../../../lib/runtime'
import { hasMusic } from '../../../lib/users'

const base = import.meta.env.BASE_URL
const users = owner()
if (!hasMusic(users)) return Astro.rewrite('/404/')
const listening = await music(users)
const source = users.lastfm === null ? 'ListenBrainz' : 'Last.fm'
const playing = playingNow(listening?.now ?? null)
const now = new Date().toISOString()
---

<Page current="music" title="Historikk" lead={`Avspillinger, dag for dag, og hvor lenge hver lytteøkt varte, fra ${source}.`} crumbs={[{ label: 'Medier', href: base }, { label: 'Musikk', href: mediumHref(base, 'music') }, { label: 'Historikk', href: mediumHref(base, 'music', 'historikk/') }]}>
  <PageSection id="okter" title="Lytteøkter" icon="listen">
    <Sessions medium="music" plays={listening?.recent ?? []} now={now} playing={playing} />
  </PageSection>
  <PageSection id="tidslinje" title="Tidslinje" icon="history">
    <HistoryTimeline medium="music" plays={listening?.recent ?? []} now={now} playing={playing} base={base} pages={listening?.source !== 'listenbrainz'} />
  </PageSection>
  <Fetched sources={[{ at: listening?.at ?? null, source }]} />
</Page>
