---
import NotFound from '@lmfaole/web/NotFound.astro'
import { brandAttributes } from '@lmfaole/designsystem/lib/brand'
import { transitionAttributes } from '@lmfaole/designsystem/lib/motion'

const base = import.meta.env.BASE_URL
---

<NotFound app="Medier" favicon={false} attributes={{ ...brandAttributes('amber'), ...transitionAttributes() }}>
  <Fragment slot="head">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#9c640d" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#c6811c" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
  </Fragment>
</NotFound>
