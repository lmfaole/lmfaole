---
import '../styles.css'
import { PageLayout } from '@lmfaole/designsystem/components/page-layout'

import { NotFoundPage } from '@lmfaole/designsystem/components/not-found-page'
import { brandAttributes } from '@lmfaole/designsystem/lib/brand'
import { transitionAttributes } from '@lmfaole/designsystem/lib/motion'

const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="nb" {...brandAttributes('amber')} {...transitionAttributes()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Siden finnes ikke – Medier</title>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#9c640d" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#c6811c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body>
    <PageLayout>
      <NotFoundPage home={base} />
    </PageLayout>
  </body>
</html>
