---
// The site's pages in the shared document (`@lmfaole/web/Document.astro`), with what the front page's are: the profile picture as the link preview,
// the phone's home-screen icon, and an address given as a path under https://lmfaole.party/.
import Document from '@lmfaole/web/Document.astro'

import { PROFILE } from '../lib/profile'

interface Props {
  title: string
  description?: string
  /** The page's own address, for the link preview; none for a page that is not one (the 404). */
  path?: string
  /** Structured data about the page (schema.org). */
  jsonLd?: Record<string, unknown>
}
const { title, description, path, jsonLd } = Astro.props
const url = path === undefined ? undefined : new URL(path.replace(/^\//, ''), PROFILE.url).href
---

<Document title={title} description={description} url={url} image={{ file: 'profilbilde.jpg', width: 460, height: 460 }} appleTouchIcon jsonLd={jsonLd}>
  <slot />
</Document>
