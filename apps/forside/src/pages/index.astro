---
// `/`: the front page, a name, one sentence, a few plain links and the owner's GitHub lately. The name, the role and the GitHub part are the D1 database's (`site`),
// or the page's own words and no GitHub while it has none (`lib/runtime`); drawn when asked and kept at the edge for a few minutes (`src/middleware.ts`).
import Document from '../layouts/Document.astro'
import { PROFILE, pageHead } from '../lib/profile'
import { currentFrontPage } from '../lib/runtime'
import { Forside } from '../views/Forside'

const page = pageHead('/')
const now = new Date()
const front = await currentFrontPage(now)
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: front.owner.name,
  url: PROFILE.url,
  image: `${PROFILE.url}profilbilde.jpg`,
  email: `mailto:${PROFILE.email}`,
  sameAs: [PROFILE.github, PROFILE.linkedin],
}
---

<Document title={front.owner.name} description={page.description} path="/" jsonLd={person}>
  <Forside page={front} now={now} />
</Document>
