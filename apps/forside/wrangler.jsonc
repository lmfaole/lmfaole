{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forside",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Only the zone's route: no workers.dev or preview address, so the site has one address.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The whole origin, except what a more specific route takes: `/medier*`, `/cv`, `/cv/*`, `/start` and `/design/` are other Workers'.
  "routes": [{ "pattern": "lmfaole.party/*", "zone_name": "lmfaole.party" }],
  // The D1 database `site` (the same id as `packages/db/wrangler.jsonc`), which `scripts/import-dump.ts` fills with the CV: the front page's name and role are read
  // from it (`src/lib/stored.ts`). The site only reads it and never migrates it: `migrations_dir` is there for a local database
  // (`npx wrangler d1 migrations apply site --local`). While it has no CV, the page says what `src/lib/profile.ts` says.
  "d1_databases": [
    { "binding": "SITE", "database_name": "site", "database_id": "e298167f-145e-41c9-ac11-0c74a80c6f43", "migrations_dir": "../../packages/db/site/migrations" }
  ]
}
