---
// The document every page of the CV stands in: the head (title, description, link preview, icon) and the page frame. No service worker,
// no cookies and no script of its own: the origin is shared with the other apps (`/`, `/medier/`, `/start`, `/design/`).
import '../styles.css'
import { PageLayout } from '@lmfaole/designsystem/components/page-layout'

interface Props {
  title: string
  description?: string
  /** The page's own address, for the link preview; none for a page that is not one (the 404). */
  url?: string
  /** `pane`: the reading column and the facts beside it on a wide screen. */
  width?: 'reading' | 'pane'
}
const { title, description, url, width = 'reading' } = Astro.props
const base = import.meta.env.BASE_URL
const image = new URL(`${base}og-image.jpg`, Astro.site).href
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description === undefined ? null : <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    {
      url === undefined ? null : (
        <>
          <link rel="canonical" href={url} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="lmfaole.party" />
          <meta property="og:locale" content="nb_NO" />
          <meta property="og:url" content={url} />
          <meta property="og:title" content={title} />
          {description === undefined ? null : <meta property="og:description" content={description} />}
          <meta property="og:image" content={image} />
          <meta property="og:image:width" content="460" />
          <meta property="og:image:height" content="460" />
        </>
      )
    }
  </head>
  <body>
    <PageLayout width={width}>
      <slot />
    </PageLayout>
  </body>
</html>
