{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker keeps the name it had in the old monorepo (`work`), so a deploy replaces it and its routes.
  "name": "work",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Only the zone's routes: no workers.dev or preview address, and no custom domain, so the site has one address.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Paths of lmfaole.party: `forside` owns `lmfaole.party/*`, and these two are more specific, so they reach this Worker.
  "routes": [
    { "pattern": "lmfaole.party/cv", "zone_name": "lmfaole.party" },
    { "pattern": "lmfaole.party/cv/*", "zone_name": "lmfaole.party" }
  ],
  // The D1 database `site` (the same id as `packages/db/wrangler.jsonc`), which `scripts/import-dump.ts` fills with the CV and `workers/catalog` keeps the
  // projects' latest commits in. The site only reads it (`src/lib/stored.ts`) and never migrates it: `migrations_dir` is there for a local database
  // (`npx wrangler d1 migrations apply site --local`). While it has no CV, the page is the snapshot `src/data/cv.json`.
  "d1_databases": [
    { "binding": "SITE", "database_name": "site", "database_id": "e298167f-145e-41c9-ac11-0c74a80c6f43", "migrations_dir": "../../packages/db/site/migrations" }
  ]
}
