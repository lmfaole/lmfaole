{
  "name": "lmfaole",
  "private": true,
  "type": "module",
  "description": "lmfaole's apps, workers and design system in one repository, all on Cloudflare",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test && npm run skills:check",
    "lint": "oxlint -c oxlintrc.json && npm run lint --workspaces --if-present",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node --test \"scripts/*.test.ts\"",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "skills:check": "npm run skills:check --workspaces --if-present",
    "hooks": "git config core.hooksPath .githooks",
    "cf:audit": "node scripts/cf-audit.ts",
    "rollout": "node scripts/rollout.ts",
    "new-app": "node scripts/new-app.ts"
  },
  "overrides": {
    "@opennextjs/cloudflare": {
      "glob": "^14.0.6"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2"
  }
}
