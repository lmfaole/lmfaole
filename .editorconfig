# The whitespace every file in the repository is written with; `npm run format` (.oxfmtrc.json) holds the code to the rest.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
